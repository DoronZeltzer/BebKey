# ────────────────────────────────────────────────────────────────────────────
# BebKey — environment variable template
# Copy to .env and fill in real values.  Variables prefixed VITE_ are
# bundled into the browser build (treat them as public).  Unprefixed
# variables are only read by Vercel serverless functions in api/.
# ────────────────────────────────────────────────────────────────────────────

# ── Supabase ───────────────────────────────────────────────────────────────
# Project URL and anon (public) key — from Supabase dashboard → API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGc...

# Service-role key — bypasses RLS, used by serverless functions and scrapers.
# NEVER expose this to the browser.  Set in Vercel + GitHub Actions secrets.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# Mirrors of the public vars, read by api/ functions where process.env is used.
# (Vercel exposes VITE_-prefixed vars to both client and server, but plain
# names are clearer for server-only code.)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGc...

# ── Google OAuth (custom PKCE flow so consent screen shows bebkey.com) ─────
# Same client ID for the browser-side redirect and the server-side exchange.
VITE_GOOGLE_CLIENT_ID=348208019241-xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_ID=348208019241-xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=https://www.bebkey.com/auth/callback

# ── Lemon Squeezy billing ──────────────────────────────────────────────────
# We use LS's URL-based checkout (no server-side API key required at runtime).
# The only sensitive value here is the webhook signing secret.
#
# Webhook signing secret you set when creating the webhook in LS dashboard
# → Settings → Webhooks.  /api/ls-webhook rejects any request whose
# X-Signature header doesn't match HMAC-SHA256(secret, body).  If unset, the
# webhook fails closed (returns 500) — anyone could otherwise forge a
# "subscription_created" event.
LEMONSQUEEZY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Store subdomain — the '<sub>' in <sub>.lemonsqueezy.com.  Used to build
# checkout URLs (https://<sub>.lemonsqueezy.com/buy/<variant-uuid>).
VITE_LS_STORE_SUBDOMAIN=bebkey
# Variant UUIDs (public — they appear in customer-facing checkout URLs).  Get
# these from LS dashboard → Products → Share → Checkout Link.  /api/ls-checkout
# allow-lists these three values so no one can craft a request for a $1 test
# variant and get treated as the Pro plan.
VITE_LS_VARIANT_STARTER=00000000-0000-0000-0000-000000000000
VITE_LS_VARIANT_PRO=00000000-0000-0000-0000-000000000000
VITE_LS_VARIANT_AGENCY=00000000-0000-0000-0000-000000000000
VITE_LS_VARIANT_OFFICE=00000000-0000-0000-0000-000000000000
# One-time boost products (agents boost a single listing). Same allow-list.
VITE_LS_VARIANT_BOOST_BUMP=00000000-0000-0000-0000-000000000000
VITE_LS_VARIANT_BOOST_FEATURED=00000000-0000-0000-0000-000000000000
VITE_LS_VARIANT_BOOST_SPOTLIGHT=00000000-0000-0000-0000-000000000000
VITE_LS_VARIANT_BOOST_TAG=00000000-0000-0000-0000-000000000000

# ── Error monitoring (optional) ────────────────────────────────────────────
# When set, Sentry init runs in main.tsx.  Leave blank for local dev.
VITE_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# ── Email validation (optional) ────────────────────────────────────────────
# Abstract API key — rejects disposable / undeliverable emails on signup.
# If blank, signup proceeds without validation.
VITE_ABSTRACT_EMAIL_KEY=

# ── Email delivery (Resend) ────────────────────────────────────────────────
# Used by /api/contact to email contact-form submissions to the support
# inbox, and by the Python scrapers for block/zero-result alerts.
# If unset, the contact form still saves to contact_messages but no email
# notification is sent — set this for production.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form submissions get delivered.  Defaults to
# doron@bebkey.com — change to support@bebkey.com once you've set up
# that alias to actually receive mail.
CONTACT_FORWARD_TO=doron@bebkey.com
